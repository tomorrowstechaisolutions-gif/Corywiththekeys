# --- Supabase (required) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public form submissions are written with the service role, because no table
# has an anonymous INSERT policy. Without this, /inventory's lead form tells
# the customer to call instead of silently losing them.
SUPABASE_SERVICE_ROLE_KEY=

# --- Abuse control -------------------------------------------------------
# Salt for hashing IP addresses in form_submissions. Required in production;
# a raw IP is never stored. Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=

# --- Bot protection (optional) -------------------------------------------
# Cloudflare Turnstile. Leave blank to run without a token check — the
# honeypot and timing checks still apply.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
